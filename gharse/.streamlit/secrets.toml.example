# Copy to .streamlit/secrets.toml for local use, or paste the same keys into the
# Secrets box of your app on share.streamlit.io. The real secrets.toml is gitignored
# and must never be committed.

# ---------------------------------------------------------------- database
# Leave this section out entirely and the app uses a local SQLite file (gharse.db),
# which is right for a laptop and WRONG for Streamlit Community Cloud: its disk is
# ephemeral, so every kitchen, order and payout disappears when the app sleeps.
# Supabase → Project Settings → Database → Connection string → URI.
[database]
url = "postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------- admin
# The password the admin account is created with on an empty database. Without this
# the app falls back to a demo password and says so on screen until you fix it.
[admin]
password = "pick-something-long-and-not-this"

# ---------------------------------------------------------------- whatsapp (optional)
# With these, order and payout messages send themselves through the WhatsApp Cloud
# API. Without them they queue in Admin → WhatsApp Outbox and go with one tap each,
# which is how a pilot should start.
WHATSAPP_TOKEN = ""
WHATSAPP_PHONE_ID = ""

# ---------------------------------------------------------------- sms (needed on Postgres)
# Phone verification codes. Without one of these, a Postgres copy sends no codes and
# nobody can verify a phone; a local SQLite copy shows the code on screen instead.
# Indian SMS needs a DLT-registered sender and OTP template — MSG91 helps with that.
[sms]
msg91_authkey = ""
msg91_template_id = ""
# twilio_sid = ""
# twilio_token = ""
# twilio_from = ""

# ---------------------------------------------------------------- kyc (optional)
# demo_otp = true shows codes on screen on Postgres too — for a test copy ONLY.
# vendor names the eKYC partner you have signed with (digilocker, idfy, hyperverge,
# signzy, digio). None is integrated yet; the team checks identities by hand.
[kyc]
demo_otp = false
vendor = ""
